# Copy to .env. These settings describe the cluster, not the experiment.
PYTHON=/absolute/path/to/empowerment-warp/.venv/bin/python
# Leave font overrides unset to use the bundled publication fonts.
# PLOTTING_FONT_ROOT=/absolute/path/to/fonts
# PLOTTING_REGULAR_FONT=/absolute/path/to/regular.otf
# PLOTTING_BOLD_FONT=/absolute/path/to/bold.otf
RUN_ROOT=/absolute/path/to/new/runs
SLURM_PARTITION=all
SLURM_ACCOUNT=
SLURM_GRES=gpu:1
SLURM_CPUS=4
# Override per submission with --mem / --time; size from measured runs.
SLURM_MEM=
SLURM_TIME=
WANDB_PROJECT=empowerment-warp
# Blank lets W&B select the authenticated account.
WANDB_ENTITY=
WANDB_MODE=offline
